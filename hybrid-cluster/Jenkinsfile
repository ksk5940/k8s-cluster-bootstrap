// =============================================================================
// Jenkinsfile — Kubernetes Cluster Bootstrap Pipeline (Jenkins on Windows)
// Uses: SSH Pipeline Steps Plugin  →  https://plugins.jenkins.io/ssh-steps/
//
// Jenkins Credential Setup (do this ONCE in Jenkins UI):
//   Dashboard → Manage Jenkins → Credentials → (global) → Add Credentials
//     Kind     : Username with password
//     Username : root          (or your SSH user)
//     Password : <your password>
//     ID       : K8S_SSH_CREDS    ← this ID is referenced below
//     Description: K8s node SSH credentials
//
// Scripts sourced from:
//   https://github.com/ksk5940/k8s-cluster-bootstrap/tree/main/hybrid-cluster
// =============================================================================

pipeline {

    agent any

    // -------------------------------------------------------------------------
    // PARAMETERS — shown as separate input fields in the Jenkins build UI
    // -------------------------------------------------------------------------
    parameters {
        string(
            name: 'MASTER_IP',
            defaultValue: '',
            description: 'IP address of the Kubernetes MASTER / control-plane node.\nExample: 192.168.1.10'
        )
        string(
            name: 'WORKER_IPS',
            defaultValue: '',
            description: 'Comma-separated list of WORKER node IPs.\nExample: 192.168.1.11,192.168.1.12,192.168.1.13\nAdd as many as needed — all provisioned in parallel.'
        )
        string(
            name: 'SSH_CREDENTIALS_ID',
            defaultValue: 'K8S_SSH_CREDS',
            description: 'Jenkins Credentials ID (Username + Password) configured for all nodes.\nSet up at: Manage Jenkins → Credentials → Add Credentials.'
        )
        string(
            name: 'GITHUB_RAW_BASE',
            defaultValue: 'https://raw.githubusercontent.com/ksk5940/k8s-cluster-bootstrap/main/hybrid-cluster',
            description: 'Raw GitHub base URL where the setup scripts are hosted.'
        )
    }

    // -------------------------------------------------------------------------
    // ENVIRONMENT
    // -------------------------------------------------------------------------
    environment {
        MASTER_SCRIPT = '01-linux-master-setup.sh'
        WORKER_SCRIPT = '02-linux-worker-setup.sh'
    }

    // -------------------------------------------------------------------------
    // STAGES
    // -------------------------------------------------------------------------
    stages {

        // =====================================================================
        // Stage 0 — Validate inputs
        // =====================================================================
        stage('Validate Inputs') {
            steps {
                script {
                    if (!params.MASTER_IP?.trim()) {
                        error('MASTER_IP cannot be empty.')
                    }
                    if (!params.WORKER_IPS?.trim()) {
                        error('WORKER_IPS cannot be empty. Provide at least one worker IP.')
                    }
                    if (!params.SSH_CREDENTIALS_ID?.trim()) {
                        error('SSH_CREDENTIALS_ID cannot be empty.')
                    }

                    def workers = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                    if (workers.isEmpty()) {
                        error('WORKER_IPS contained no valid IPs after parsing.')
                    }

                    echo "Master IP      : ${params.MASTER_IP.trim()}"
                    echo "Worker IPs     : ${workers.join(', ')}"
                    echo "Worker count   : ${workers.size()}"
                    echo "Credentials ID : ${params.SSH_CREDENTIALS_ID}"
                }
            }
        }

        // =====================================================================
        // Stage 1 — Verify SSH connectivity to every node
        // =====================================================================
        stage('Verify SSH Connectivity') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: params.SSH_CREDENTIALS_ID,
                        usernameVariable: 'SSH_USER',
                        passwordVariable: 'SSH_PASS'
                    )
                ]) {
                    script {
                        def workers  = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                        def allNodes = [params.MASTER_IP.trim()] + workers
                        def checks   = [:]

                        allNodes.each { ip ->
                            checks["ssh-check: ${ip}"] = {
                                def remote = buildRemote(ip, env.SSH_USER, env.SSH_PASS)
                                sshCommand remote: remote,
                                           command: 'echo "SSH OK from $(hostname) [$(hostname -I | tr -d \'\\n\')]"'
                            }
                        }

                        parallel checks
                        echo "All ${allNodes.size()} node(s) reachable via SSH."
                    }
                }
            }
        }

        // =====================================================================
        // Stage 2 — Provision Master Node
        // =====================================================================
        stage('Provision Master Node') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: params.SSH_CREDENTIALS_ID,
                        usernameVariable: 'SSH_USER',
                        passwordVariable: 'SSH_PASS'
                    )
                ]) {
                    script {
                        def masterIp = params.MASTER_IP.trim()
                        def remote   = buildRemote(masterIp, env.SSH_USER, env.SSH_PASS)

                        echo "============================================================"
                        echo " Provisioning MASTER: ${masterIp}"
                        echo "============================================================"

                        // Download script to the remote node
                        sshCommand remote: remote, command: """
                            curl -fsSL '${params.GITHUB_RAW_BASE}/${MASTER_SCRIPT}' \
                                 -o /tmp/${MASTER_SCRIPT} && \
                            chmod +x /tmp/${MASTER_SCRIPT}
                        """

                        // Run it — live output streams to Jenkins console
                        sshCommand remote: remote, command: "bash /tmp/${MASTER_SCRIPT}"

                        echo "Master provisioning COMPLETE: ${masterIp}"
                    }
                }
            }
        }

        // =====================================================================
        // Stage 3 — Extract kubeadm join command from master
        //           Sequential gate — workers wait for this before starting.
        // =====================================================================
        stage('Extract Join Command') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: params.SSH_CREDENTIALS_ID,
                        usernameVariable: 'SSH_USER',
                        passwordVariable: 'SSH_PASS'
                    )
                ]) {
                    script {
                        def masterIp = params.MASTER_IP.trim()
                        def remote   = buildRemote(masterIp, env.SSH_USER, env.SSH_PASS)

                        echo "Fetching kubeadm join command from master ${masterIp} ..."

                        def rawOutput = sshCommand(
                            remote      : remote,
                            command     : 'kubeadm token create --print-join-command 2>/dev/null',
                            returnStdout: true
                        ).trim()

                        // Isolate the join line defensively (output may include banner lines)
                        def joinLine = rawOutput.split('\n')
                                               .collect { it.trim() }
                                               .find { it.startsWith('kubeadm join') }

                        if (!joinLine) {
                            error("Could not find a valid 'kubeadm join ...' line.\nRaw output:\n${rawOutput}")
                        }

                        // Persist across stages via env
                        env.JOIN_COMMAND = joinLine
                        echo "Join command captured successfully."
                        echo "Preview: ${joinLine.take(72)}..."
                    }
                }
            }
        }

        // =====================================================================
        // Stage 4 — Provision Worker Nodes IN PARALLEL
        //
        //   Per worker:
        //     a) Download 02-linux-worker-setup.sh
        //     b) Patch out the interactive `read -r JOIN_CMD` with the real command
        //     c) Execute the patched script — joins cluster automatically
        // =====================================================================
        stage('Provision Worker Nodes (Parallel)') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: params.SSH_CREDENTIALS_ID,
                        usernameVariable: 'SSH_USER',
                        passwordVariable: 'SSH_PASS'
                    )
                ]) {
                    script {
                        def workers    = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                        def joinCmd    = env.JOIN_COMMAND
                        def workerJobs = [:]

                        workers.eachWithIndex { ip, idx ->
                            def workerIp = ip        // local binding for closure
                            def num      = idx + 1

                            workerJobs["worker-${num} [${workerIp}]"] = {
                                def remote = buildRemote(workerIp, env.SSH_USER, env.SSH_PASS)

                                echo "============================================================"
                                echo " Provisioning WORKER ${num}: ${workerIp}"
                                echo "============================================================"

                                // Step A: Download script
                                sshCommand remote: remote, command: """
                                    curl -fsSL '${params.GITHUB_RAW_BASE}/${WORKER_SCRIPT}' \
                                         -o /tmp/${WORKER_SCRIPT} && \
                                    chmod +x /tmp/${WORKER_SCRIPT}
                                """

                                // Step B: Patch `read -r JOIN_CMD` → direct variable assignment.
                                //         Escapes single-quotes in joinCmd for safe sed injection.
                                def escapedJoin = joinCmd.replace("'", "'\\''")
                                sshCommand remote: remote, command: """
                                    sed -i "s|read -r JOIN_CMD|JOIN_CMD='${escapedJoin}'|g" \
                                        /tmp/${WORKER_SCRIPT}
                                """

                                // Step C: Run the patched worker script
                                sshCommand remote: remote, command: "bash /tmp/${WORKER_SCRIPT}"

                                echo "Worker ${num} (${workerIp}) joined the cluster successfully."
                            }
                        }

                        // failFast false → all workers attempt even if one fails
                        workerJobs.failFast = false
                        parallel workerJobs
                    }
                }
            }
        }

        // =====================================================================
        // Stage 5 — Verify cluster health from master
        // =====================================================================
        stage('Verify Cluster') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: params.SSH_CREDENTIALS_ID,
                        usernameVariable: 'SSH_USER',
                        passwordVariable: 'SSH_PASS'
                    )
                ]) {
                    script {
                        def masterIp = params.MASTER_IP.trim()
                        def remote   = buildRemote(masterIp, env.SSH_USER, env.SSH_PASS)

                        echo "Waiting 20s for all nodes to register with the API server..."
                        sleep(20)

                        def nodeStatus = sshCommand(
                            remote      : remote,
                            command     : 'kubectl get nodes -o wide',
                            returnStdout: true
                        )

                        echo "============================================================"
                        echo " CLUSTER NODE STATUS"
                        echo "============================================================"
                        echo nodeStatus
                    }
                }
            }
        }
    }

    // -------------------------------------------------------------------------
    // POST
    // -------------------------------------------------------------------------
    post {
        success {
            script {
                def workers = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                echo """
╔══════════════════════════════════════════════════════════════════╗
║        Kubernetes Cluster Bootstrap — SUCCESS                   ║
╠══════════════════════════════════════════════════════════════════╣
║  Master  : ${params.MASTER_IP.trim()}
║  Workers : ${params.WORKER_IPS.trim()}
║  Total   : 1 master + ${workers.size()} worker(s)
╠══════════════════════════════════════════════════════════════════╣
║  Verify from master:  kubectl get nodes -o wide                 ║
╚══════════════════════════════════════════════════════════════════╝"""
            }
        }
        failure {
            echo """
╔══════════════════════════════════════════════════════════════════╗
║        Kubernetes Cluster Bootstrap — FAILED                    ║
╠══════════════════════════════════════════════════════════════════╣
║  Troubleshooting checklist:                                     ║
║   1. Credentials ID matches exactly in Jenkins credential store ║
║   2. SSH Pipeline Steps plugin installed in Jenkins             ║
║   3. All node IPs reachable on port 22 from Jenkins agent       ║
║   4. GITHUB_RAW_BASE URL returns scripts (test in browser)      ║
║   5. Nodes have enough disk (20 GB+) and RAM (2 GB+)            ║
╚══════════════════════════════════════════════════════════════════╝"""
        }
        always {
            echo "Pipeline finished at: ${new Date()}"
        }
    }
}

// =============================================================================
// HELPER — Build the SSH remote map for SSH Pipeline Steps plugin
// =============================================================================
def buildRemote(String ip, String user, String password) {
    return [
        name         : ip,
        host         : ip,
        port         : 22,
        user         : user,
        password     : password,
        allowAnyHosts: true,   // StrictHostKeyChecking=no equivalent
        timeoutSec   : 3600    // 1 hour max per command (K8s install can be slow)
    ]
}
