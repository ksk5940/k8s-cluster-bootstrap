// =============================================================================
// Jenkinsfile — Kubernetes Cluster Bootstrap Pipeline
// Compatible with: Jenkins on Windows OR Linux (auto-detected at runtime)
// Target nodes  : Ubuntu / Rocky Linux
//
// Uses: SSH Pipeline Steps Plugin → https://plugins.jenkins.io/ssh-steps/
//
// SECURITY: Uses a non-root sudo user instead of root.
//
// Pre-requisite on EACH node (run once manually):
//   For Ubuntu nodes:
//     usermod -aG sudo ubuntu
//     echo "ubuntu ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/ubuntu
//
//   For Rocky nodes:
//     usermod -aG wheel rocky
//     echo "rocky ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/rocky
//
// Jenkins Credential Setup (once):
//   Manage Jenkins → Credentials → global → Add Credentials
//     Kind     : Username with password
//     Username : ubuntu   (or rocky — whichever user exists on your nodes)
//     Password : <user password>
//     ID       : K8S_SSH_CREDS
//
// Scripts live in the SAME repo as this Jenkinsfile:
//   hybrid-cluster/01-linux-master-setup.sh
//   hybrid-cluster/02-linux-worker-setup.sh
// =============================================================================

pipeline {

    agent any

    parameters {
        string(
            name: 'MASTER_IP',
            defaultValue: '',
            description: 'IP address of the Kubernetes MASTER node.\nExample: 192.168.56.11'
        )
        string(
            name: 'WORKER_IPS',
            defaultValue: '',
            description: 'Comma-separated WORKER node IPs.\nExample: 192.168.56.12,192.168.56.13\nAdd as many as needed — all provisioned in parallel.'
        )
        string(
            name: 'SSH_CREDENTIALS_ID',
            defaultValue: 'K8S_SSH_CREDS',
            description: 'Jenkins Credentials ID (Username + Password).\nUsername should be a sudo user (e.g. ubuntu or rocky), NOT root.'
        )
    }

    environment {
        REMOTE_MASTER_SCRIPT = '/tmp/01-linux-master-setup.sh'
        REMOTE_WORKER_SCRIPT = '/tmp/02-linux-worker-setup.sh'
    }

    stages {

        // =====================================================================
        // Stage 0 — Detect Jenkins OS + Validate Inputs
        // =====================================================================
        stage('Validate Inputs') {
            steps {
                script {
                    // Auto-detect Jenkins agent OS
                    env.IS_UNIX = isUnix() ? 'true' : 'false'
                    echo "Jenkins agent OS: ${isUnix() ? 'Linux/Mac' : 'Windows'}"

                    // Set correct path separator for local script paths
                    if (isUnix()) {
                        env.LOCAL_MASTER_SCRIPT = 'hybrid-cluster/01-linux-master-setup.sh'
                        env.LOCAL_WORKER_SCRIPT = 'hybrid-cluster/02-linux-worker-setup.sh'
                    } else {
                        env.LOCAL_MASTER_SCRIPT = 'hybrid-cluster\\01-linux-master-setup.sh'
                        env.LOCAL_WORKER_SCRIPT = 'hybrid-cluster\\02-linux-worker-setup.sh'
                    }

                    if (!params.MASTER_IP?.trim()) {
                        error('MASTER_IP cannot be empty.')
                    }
                    if (!params.WORKER_IPS?.trim()) {
                        error('WORKER_IPS cannot be empty.')
                    }

                    def workers = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                    if (workers.isEmpty()) {
                        error('No valid worker IPs found after parsing.')
                    }

                    echo "Master IP    : ${params.MASTER_IP.trim()}"
                    echo "Worker IPs   : ${workers.join(', ')}"
                    echo "Worker count : ${workers.size()}"
                    echo "Credentials  : ${params.SSH_CREDENTIALS_ID}"
                }
            }
        }

        // =====================================================================
        // Stage 1 — Verify SSH Connectivity + Confirm sudo Access
        // =====================================================================
        stage('Verify SSH Connectivity') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: params.SSH_CREDENTIALS_ID,
                    usernameVariable: 'SSH_USER',
                    passwordVariable: 'SSH_PASS'
                )]) {
                    script {
                        def workers  = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                        def allNodes = [params.MASTER_IP.trim()] + workers
                        def checks   = [:]

                        allNodes.each { ip ->
                            checks["ssh-check: ${ip}"] = {
                                def remote = buildRemote(ip, env.SSH_USER, env.SSH_PASS)

                                // Check SSH works
                                sshCommand remote: remote,
                                           command: 'echo "SSH OK from $(hostname) as $(whoami)"'

                                // Check sudo works without password (NOPASSWD)
                                sshCommand remote: remote,
                                           command: 'sudo -n whoami | grep -q root && echo "SUDO OK" || (echo "SUDO FAILED - ensure NOPASSWD is configured" && exit 1)'
                            }
                        }

                        parallel checks
                        echo "All ${allNodes.size()} node(s) reachable. SSH + sudo verified."
                    }
                }
            }
        }

        // =====================================================================
        // Stage 2 — Provision Master Node
        //
        // sshPut  → copies script as the sudo user to /tmp
        // sed     → strips Windows CRLF (safe no-op if already LF)
        // sudo    → runs script with root privileges
        // =====================================================================
        stage('Provision Master Node') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: params.SSH_CREDENTIALS_ID,
                    usernameVariable: 'SSH_USER',
                    passwordVariable: 'SSH_PASS'
                )]) {
                    script {
                        def masterIp = params.MASTER_IP.trim()
                        def remote   = buildRemote(masterIp, env.SSH_USER, env.SSH_PASS)

                        echo "============================================================"
                        echo " Jenkins OS  : ${env.IS_UNIX == 'true' ? 'Linux/Mac' : 'Windows'}"
                        echo " SSH User    : ${env.SSH_USER} (sudo)"
                        echo " Provisioning MASTER: ${masterIp}"
                        echo "============================================================"

                        // Copy script to /tmp (writable by any user)
                        sshPut remote: remote,
                               from: env.LOCAL_MASTER_SCRIPT,
                               into: env.REMOTE_MASTER_SCRIPT

                        // Strip CRLF → make executable → run with sudo
                        sshCommand remote: remote,
                                   command: """
                                       sed -i 's/\\r//' ${env.REMOTE_MASTER_SCRIPT} && \
                                       chmod +x ${env.REMOTE_MASTER_SCRIPT} && \
                                       sudo bash ${env.REMOTE_MASTER_SCRIPT}
                                   """

                        // -------------------------------------------------------
                        // Setup .kube/config for the SSH user (e.g. ubuntu)
                        // The master script configures kubectl for root only.
                        // This copies admin.conf to the SSH user home directory
                        // so kubectl works without sudo for that user.
                        // -------------------------------------------------------
                        echo "Setting up .kube/config for user: ${env.SSH_USER} ..."
                        sshCommand remote: remote,
                                   command: """
                                       mkdir -p \$HOME/.kube && \
                                       sudo cp /etc/kubernetes/admin.conf \$HOME/.kube/config && \
                                       sudo chown \$(id -u):\$(id -g) \$HOME/.kube/config && \
                                       chmod 600 \$HOME/.kube/config
                                   """

                        // Verify kubectl works as the SSH user without sudo
                        sshCommand remote: remote,
                                   command: 'kubectl get nodes'

                        echo "kubectl configured for user: ${env.SSH_USER} at ~/.kube/config"
                        echo "Master provisioning COMPLETE: ${masterIp}"
                    }
                }
            }
        }

        // =====================================================================
        // Stage 3 — Extract kubeadm join command from master
        // =====================================================================
        stage('Extract Join Command') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: params.SSH_CREDENTIALS_ID,
                    usernameVariable: 'SSH_USER',
                    passwordVariable: 'SSH_PASS'
                )]) {
                    script {
                        def masterIp = params.MASTER_IP.trim()
                        def remote   = buildRemote(masterIp, env.SSH_USER, env.SSH_PASS)

                        echo "Fetching kubeadm join command from master ${masterIp} ..."

                        // sudo required — kubeadm needs root
                        def rawOutput = sshCommand(
                            remote      : remote,
                            command     : 'sudo kubeadm token create --print-join-command 2>/dev/null',
                            returnStdout: true
                        ).trim()

                        def joinLine = rawOutput.split('\n')
                                               .collect { it.trim() }
                                               .find { it.startsWith('kubeadm join') }

                        if (!joinLine) {
                            error("Could not find 'kubeadm join' line.\nRaw output:\n${rawOutput}")
                        }

                        env.JOIN_COMMAND = joinLine
                        echo "Join command captured."
                        echo "Preview: ${joinLine.take(72)}..."
                    }
                }
            }
        }

        // =====================================================================
        // Stage 4 — Provision Worker Nodes IN PARALLEL
        // =====================================================================
        stage('Provision Worker Nodes (Parallel)') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: params.SSH_CREDENTIALS_ID,
                    usernameVariable: 'SSH_USER',
                    passwordVariable: 'SSH_PASS'
                )]) {
                    script {
                        def workers    = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                        def joinCmd    = env.JOIN_COMMAND
                        def workerJobs = [:]

                        workers.eachWithIndex { ip, idx ->
                            def workerIp = ip
                            def num      = idx + 1

                            workerJobs["worker-${num} [${workerIp}]"] = {
                                def remote = buildRemote(workerIp, env.SSH_USER, env.SSH_PASS)

                                echo "============================================================"
                                echo " Provisioning WORKER ${num}: ${workerIp}"
                                echo "============================================================"

                                // Copy script to /tmp
                                sshPut remote: remote,
                                       from: env.LOCAL_WORKER_SCRIPT,
                                       into: env.REMOTE_WORKER_SCRIPT

                                // Strip CRLF → make executable → inject join cmd → run with sudo
                                def escapedJoin = joinCmd.replace("'", "'\\''")
                                sshCommand remote: remote, command: """
                                    sed -i 's/\\r//' ${env.REMOTE_WORKER_SCRIPT} && \
                                    chmod +x ${env.REMOTE_WORKER_SCRIPT} && \
                                    sed -i "s|read -r JOIN_CMD|JOIN_CMD='${escapedJoin}'|g" ${env.REMOTE_WORKER_SCRIPT} && \
                                    sudo bash ${env.REMOTE_WORKER_SCRIPT}
                                """

                                echo "Worker ${num} (${workerIp}) joined successfully."
                            }
                        }

                        workerJobs.failFast = false
                        parallel workerJobs
                    }
                }
            }
        }

        // =====================================================================
        // Stage 5 — Wait for ALL Nodes Ready + ALL Pods Running
        //
        // Polls every 15 seconds (up to 10 minutes).
        // Pipeline only exits SUCCESS when:
        //   ✅ Every node   → STATUS = Ready
        //   ✅ Every pod    → STATUS = Running or Completed
        //   ✅ Every pod    → READY  = x/x (no 0/1 containers)
        // If not healthy within 10 min → pipeline fails with clear message.
        // =====================================================================
        stage('Verify Cluster') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: params.SSH_CREDENTIALS_ID,
                    usernameVariable: 'SSH_USER',
                    passwordVariable: 'SSH_PASS'
                )]) {
                    script {
                        def masterIp     = params.MASTER_IP.trim()
                        def remote       = buildRemote(masterIp, env.SSH_USER, env.SSH_PASS)
                        def maxWaitSecs  = 600   // 10 minutes max
                        def pollInterval = 15    // poll every 15 seconds
                        def elapsed      = 0
                        def clusterReady = false

                        echo "============================================================"
                        echo " Polling cluster health every ${pollInterval}s (max ${maxWaitSecs}s)"
                        echo " Waiting for ALL nodes Ready + ALL pods Running..."
                        echo "============================================================"

                        while (!clusterReady && elapsed < maxWaitSecs) {

                            sleep(pollInterval)
                            elapsed += pollInterval

                            // Count nodes that are NOT Ready
                            def notReadyNodes = sshCommand(
                                remote      : remote,
                                command     : "kubectl get nodes --no-headers | grep -vc ' Ready' || true",
                                returnStdout: true
                            ).trim().toInteger()

                            // Count pods NOT in Running or Completed state
                            def notRunningPods = sshCommand(
                                remote      : remote,
                                command     : "kubectl get pods -A --no-headers | awk '\$4 != \"Running\" && \$4 != \"Completed\"' | wc -l",
                                returnStdout: true
                            ).trim().toInteger()

                            // Count pods where READY column is not x/x (e.g. 0/1)
                            def notReadyContainers = sshCommand(
                                remote      : remote,
                                command     : "kubectl get pods -A --no-headers | awk -F' ' '{split(\$3,a,\"/\"); if(a[1]!=a[2]) print}' | wc -l",
                                returnStdout: true
                            ).trim().toInteger()

                            echo "[${elapsed}s/${maxWaitSecs}s] Not-Ready nodes: ${notReadyNodes} | Non-Running pods: ${notRunningPods} | Unready containers: ${notReadyContainers}"

                            if (notReadyNodes == 0 && notRunningPods == 0 && notReadyContainers == 0) {
                                clusterReady = true
                            }
                        }

                        // ---- Print final status regardless ----
                        def nodeStatus = sshCommand(
                            remote      : remote,
                            command     : 'kubectl get nodes -o wide',
                            returnStdout: true
                        )
                        def podStatus = sshCommand(
                            remote      : remote,
                            command     : 'kubectl get pods -A',
                            returnStdout: true
                        )

                        echo "============================================================"
                        echo " FINAL NODE STATUS"
                        echo "============================================================"
                        echo nodeStatus

                        echo "============================================================"
                        echo " FINAL POD STATUS"
                        echo "============================================================"
                        echo podStatus

                        // ---- Fail pipeline if cluster never became healthy ----
                        if (!clusterReady) {
                            error("❌ Cluster did not reach fully healthy state within ${maxWaitSecs}s.\nSee node/pod status above for details.")
                        }

                        echo "============================================================"
                        echo " ✅ ALL NODES READY | ALL PODS RUNNING — Cluster is healthy!"
                        echo "============================================================"
                    }
                }
            }
        }
    }

    // -------------------------------------------------------------------------
    // POST
    // -------------------------------------------------------------------------
    post {
        success {
            script {
                def workers = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                echo """
╔══════════════════════════════════════════════════════════════════╗
║        Kubernetes Cluster Bootstrap — SUCCESS                   ║
╠══════════════════════════════════════════════════════════════════╣
║  Master  : ${params.MASTER_IP.trim()}
║  Workers : ${params.WORKER_IPS.trim()}
║  Total   : 1 master + ${workers.size()} worker(s)
╠══════════════════════════════════════════════════════════════════╣
║  Verify:  sudo kubectl get nodes -o wide                        ║
╚══════════════════════════════════════════════════════════════════╝"""
            }
        }
        failure {
            echo """
╔══════════════════════════════════════════════════════════════════╗
║        Kubernetes Cluster Bootstrap — FAILED                    ║
╠══════════════════════════════════════════════════════════════════╣
║  Troubleshooting checklist:                                     ║
║   1. SSH user has NOPASSWD sudo configured on all nodes         ║
║   2. SSH credentials correct in Jenkins credential store        ║
║   3. SSH Pipeline Steps plugin installed                        ║
║   4. All nodes reachable on port 22                             ║
║   5. Nodes have 2GB+ RAM and 20GB+ disk                         ║
╚══════════════════════════════════════════════════════════════════╝"""
        }
        always {
            echo "Pipeline finished at: ${new Date()}"
        }
    }
}

// =============================================================================
// HELPER — Build SSH remote map for SSH Pipeline Steps plugin
// =============================================================================
def buildRemote(String ip, String user, String password) {
    return [
        name         : ip,
        host         : ip,
        port         : 22,
        user         : user,
        password     : password,
        allowAnyHosts: true,
        timeoutSec   : 3600
    ]
}
