// =============================================================================
//  Jenkinsfile  —  Kubernetes Cluster Management (hybrid-cluster)
//  Actions: bootstrap | destroy | reset | upgrade
//
//  Changes:
//    - Added ENABLE_FIREWALL checkbox (default: checked/true)
//      true  → enable firewall on all nodes + open required K8s ports
//      false → disable firewall on all nodes
//      If firewall already active and ENABLE_FIREWALL=true, ports are opened.
//    - ENABLE_FIREWALL is passed to master and all worker scripts via env var
//    - Destroy: does NOT toggle firewall (destroy removes K8s — firewall state
//      is left as-is, i.e. if firewall was running it keeps running but K8s
//      port rules are removed by the destroy script)
//    - Fixed RHEL/Rocky worker: clock is synced before kubeadm join (prevents
//      x509 "current time is before certificate validity" errors)
//    - reset action: destroy then re-bootstrap
//    - upgrade action: version-gap-aware (minor-by-minor)
// =============================================================================

@NonCPS
def recordTiming(Map timings, String key, long start, long end) {
  timings[key] = [start: start, end: end]
}

@NonCPS
def buildVersionPath(String from, String to) {
  def fromParts = from.split('\\.').collect { it.toInteger() }
  def toParts   = to.split('\\.').collect   { it.toInteger() }
  def steps = []
  int major = fromParts[0]
  int startMinor = fromParts[1] + 1
  int endMinor   = toParts[1]
  for (int m = startMinor; m <= endMinor; m++) {
    steps << "${major}.${m}"
  }
  return steps
}

// ── Pipeline ──────────────────────────────────────────────────────────────────
def timings   = [:]
def pipeStart = 0L

pipeline {

  agent any

  parameters {
    choice(
      name: 'ACTION',
      choices: ['bootstrap', 'destroy', 'reset', 'upgrade'],
      description: '''bootstrap — provision fresh cluster
destroy  — tear down all nodes (full cleanup)
reset    — destroy then bootstrap (clean re-provision)
upgrade  — upgrade cluster version (minor-by-minor if gap > 1)'''
    )
    string(
      name: 'MASTER_IP',
      defaultValue: '192.168.56.11',
      description: 'Control-plane node IP'
    )
    string(
      name: 'WORKER_IPS',
      defaultValue: '192.168.56.12,192.168.56.13',
      description: 'Comma-separated worker IPs'
    )
    string(
      name: 'SSH_USER',
      defaultValue: 'k8sadmin',
      description: 'SSH user on all nodes (must have NOPASSWD sudo)'
    )
    credentials(
      name: 'SSH_CREDS_ID',
      credentialType: 'com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl',
      defaultValue: 'K8S_SSH_CREDS',
      description: 'Jenkins credential ID — SSH username + password'
    )
    choice(
      name: 'RUNTIME',
      choices: ['containerd', 'crio'],
      description: 'Container runtime: containerd | crio'
    )
    choice(
      name: 'CNI_PLUGIN',
      choices: ['calico', 'flannel', 'weave'],
      description: 'CNI plugin: calico | flannel | weave'
    )
    string(
      name: 'K8S_VERSION',
      defaultValue: '1.32.3',
      description: 'Target Kubernetes version (e.g. 1.32.3)'
    )
    string(
      name: 'K8S_CURRENT_VERSION',
      defaultValue: '',
      description: '[upgrade only] Current installed version (e.g. 1.30.5). Leave blank to auto-detect.'
    )
    string(
      name: 'POD_CIDR',
      defaultValue: '10.244.0.0/16',
      description: 'Pod network CIDR'
    )
    booleanParam(
      name: 'SET_STATIC_IP',
      defaultValue: false,
      description: 'Run 00-set-static-ip-hostname.sh on all nodes before provisioning'
    )
    booleanParam(
      name: 'ENABLE_FIREWALL',
      defaultValue: true,
      description: '''Enable firewall on all nodes and open required Kubernetes ports.
Checked (true):  firewall is enabled; required K8s ports are opened on each node role.
                 If firewall is already active, only the required ports are added.
Unchecked (false): firewall is disabled on all nodes (ufw disable / firewalld disable).'''
    )
  }

  options {
    timestamps()
    timeout(time: 120, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  environment {
    SCRIPT_DIR = 'hybrid-cluster'
  }

  stages {

    // ── 0. Validate ───────────────────────────────────────────────────────────
    stage('Validate Repository') {
      steps {
        script {
          def required = [
            '00-set-static-ip-hostname.sh',
            '01-linux-master-setup.sh',
            '02-linux-worker-setup.sh',
            '03-linux-destroy.sh',
            '04-linux-upgrade.sh',
            '07-validate.sh'
          ]
          def missing = required.findAll { f ->
            !fileExists("${env.WORKSPACE}/${SCRIPT_DIR}/${f}")
          }
          if (!missing.isEmpty()) {
            error("Required cluster script(s) missing from ${SCRIPT_DIR}: ${missing.join(', ')}")
          }
          echo "Repository preflight passed: ${required.size()} required scripts present."
        }
      }
    }

    stage('Validate Inputs') {
      steps {
        script {
          pipeStart = System.currentTimeMillis()
          def workers = params.WORKER_IPS.tokenize(',').collect { it.trim() }

          echo "ACTION           : ${params.ACTION}"
          echo "Master IP        : ${params.MASTER_IP}"
          echo "Worker IPs       : ${workers.join(', ')}"
          echo "Runtime          : ${params.RUNTIME}"
          echo "CNI              : ${params.CNI_PLUGIN}"
          echo "K8s version      : ${params.K8S_VERSION}"
          echo "Pod CIDR         : ${params.POD_CIDR}"
          echo "Set Static IP    : ${params.SET_STATIC_IP}"
          echo "Enable Firewall  : ${params.ENABLE_FIREWALL}"

          if (!params.MASTER_IP?.trim())  error('MASTER_IP is required')
          if (!params.WORKER_IPS?.trim()) error('WORKER_IPS is required')

          if (params.ACTION in ['bootstrap', 'reset', 'upgrade']) {
            if (!params.K8S_VERSION?.trim()) {
              error('K8S_VERSION is required for bootstrap/reset/upgrade')
            }
            if (!(params.K8S_VERSION ==~ /\d+\.\d+\.\d+/)) {
              error("K8S_VERSION must be in format MAJOR.MINOR.PATCH (e.g. 1.32.3)")
            }
          }
        }
      }
    }

    // ── 1. SSH Connectivity ───────────────────────────────────────────────────
    stage('Verify SSH Connectivity') {
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def allIPs = ([params.MASTER_IP] + params.WORKER_IPS.tokenize(',').collect { it.trim() }).unique()
            def branches = [:]
            allIPs.each { ip ->
              def host = ip
              branches["ssh-check: ${host}"] = {
                def remote = [name: host, host: host, user: params.SSH_USER,
                              password: env.SSH_PASS, allowAnyHosts: true]
                sshCommand remote: remote,
                  command: "echo \"SSH OK from \$(hostname) as \$(whoami)\""
                sshCommand remote: remote,
                  command: "sudo -n whoami | grep -q root && echo 'SUDO OK' || (echo 'SUDO FAILED' && exit 1)"
              }
            }
            parallel branches
            echo "All ${allIPs.size()} node(s) reachable."
          }
        }
      }
    }

    // ── 1b. Optional: Set Static IP + Hostname ────────────────────────────────
    stage('Set Static IP and Hostname') {
      when {
        expression {
          params.SET_STATIC_IP && params.ACTION in ['bootstrap', 'reset']
        }
      }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def masterIp  = params.MASTER_IP
            def workerList = params.WORKER_IPS.tokenize(',').collect { it.trim() }
            def allNodes  = [[ip: masterIp, role: 'master', hostname: 'k8s-master']]
            workerList.eachWithIndex { ip, idx ->
              allNodes << [ip: ip, role: 'worker', hostname: "k8s-worker-${idx + 1}"]
            }

            def localScript = "${env.WORKSPACE}/${SCRIPT_DIR}/00-set-static-ip-hostname.sh"
            def branches = [:]

            allNodes.each { node ->
              def n = node
              branches["static-ip: ${n.ip}"] = {
                def remote = [name: n.ip, host: n.ip, user: params.SSH_USER,
                              password: env.SSH_PASS, allowAnyHosts: true]
                sshPut remote: remote, from: localScript, into: '/tmp/00-set-static-ip-hostname.sh'
                sshCommand remote: remote, command: """
                  sed -i 's/\\r//' /tmp/00-set-static-ip-hostname.sh && \\
                  chmod +x /tmp/00-set-static-ip-hostname.sh && \\
                  export NODE_IP='${n.ip}' \\
                         NODE_HOSTNAME='${n.hostname}' \\
                         NODE_ROLE='${n.role}' && \\
                  sudo -E bash /tmp/00-set-static-ip-hostname.sh
                """.stripIndent().trim()
              }
            }
            parallel branches
            echo "Static IP and hostname configuration complete on all nodes."
          }
        }
      }
    }

    // ═════════════════════════════════════════════════════════════════════════
    //  BOOTSTRAP  (master first, then workers in parallel)
    // ═════════════════════════════════════════════════════════════════════════

    stage('Registry Network Preflight') {
      steps {
        withCredentials([usernamePassword(credentialsId: params.SSH_CREDS_ID, usernameVariable: 'SSH_USER', passwordVariable: 'SSH_PASS')]) {
          script {
            def nodes = ([params.MASTER_IP] + params.WORKER_IPS.tokenize(',').collect { it.trim() }).unique()
            def branches = [:]
            nodes.each { ip ->
              branches["registry-check: ${ip}"] = {
                def host = [name: ip, host: ip, user: env.SSH_USER, password: env.SSH_PASS, allowAnyHosts: true]
                sshCommand(remote: host, command: '''
                  set -eu
                  V4="\$(getent ahostsv4 registry.k8s.io 2>/dev/null | awk 'NR==1{print $1}')"
                  test -n "\$V4"
                  timeout 10 bash -c "cat </dev/null >/dev/tcp/\$V4/443"
                  echo "registry.k8s.io IPv4 connectivity OK: \$V4:443"
                ''')
              }
            }
            parallel branches
          }
        }
      }
    }

    stage('Provision Master Node') {
      when { expression { params.ACTION in ['bootstrap', 'reset'] } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def masterRemote = [name: params.MASTER_IP, host: params.MASTER_IP,
                                user: params.SSH_USER, password: env.SSH_PASS, allowAnyHosts: true]
            def localMaster  = "${env.WORKSPACE}/${SCRIPT_DIR}/01-linux-master-setup.sh"

            echo "Provisioning MASTER: ${params.MASTER_IP}"
            sshPut remote: masterRemote, from: localMaster, into: '/tmp/01-linux-master-setup.sh'

            def tStart = System.currentTimeMillis()
            def firewallValue = params.ENABLE_FIREWALL.toString()
            sshCommand remote: masterRemote, command: """
              sed -i 's/\\r//' /tmp/01-linux-master-setup.sh && \\
              chmod +x /tmp/01-linux-master-setup.sh && \\
              export MASTER_IP='${params.MASTER_IP}' \\
                     K8S_VERSION='${params.K8S_VERSION}' \\
                     RUNTIME='${params.RUNTIME}' \\
                     CNI_PLUGIN='${params.CNI_PLUGIN}' \\
                     POD_CIDR='${params.POD_CIDR}' \\
                     SETUP_USER='${params.SSH_USER}' \\
                     ENABLE_FIREWALL='${firewallValue}' \\
                     DEBIAN_FRONTEND=noninteractive && \\
              set +e
              sudo -E bash /tmp/01-linux-master-setup.sh
              rc=$?
              if [ "\$rc" -eq 141 ]; then
                echo "Bootstrap returned 141 (SIGPIPE); retrying once..."
                sleep 2
                sudo -E bash /tmp/01-linux-master-setup.sh
                rc=$?
              fi
              exit "\$rc" 
            """.stripIndent().trim()

            recordTiming(timings, 'master', tStart, System.currentTimeMillis())
            echo "Master provisioning complete."
          }
        }
      }
    }

    stage('Extract Join Command') {
      when { expression { params.ACTION in ['bootstrap', 'reset'] } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def masterRemote = [name: params.MASTER_IP, host: params.MASTER_IP,
                                user: params.SSH_USER, password: env.SSH_PASS, allowAnyHosts: true]
            // The join-command file is root-owned on the master.
            // Do NOT use sshGet/SFTP here because SFTP cannot sudo.
            // Read it through the existing NOPASSWD sudo permission instead.
            def joinCommand = sshCommand(
              remote: masterRemote,
              command: "sudo -n cat /tmp/k8s-join-command.sh"
            ).trim()

            if (!joinCommand) {
              error("Failed to extract Kubernetes join command from master")
            }

            // Basic safety validation: kubeadm join must be the command
            // generated by the master setup script.
            if (!joinCommand.startsWith("kubeadm join ")) {
              error("Invalid kubeadm join command received from master")
            }
            if (joinCommand.contains("\n") || joinCommand.contains("\r")) {
              error("Join command contains unexpected newline characters")
            }

            def joinFile = "${env.WORKSPACE}/.k8s-join-command.sh"

            writeFile(
              file: joinFile,
              text: "${joinCommand}\n"
            )

            sh "chmod 600 '${joinFile}'"

            env.JOIN_CMD_FILE = joinFile
            echo "Join command extracted securely via sudo."
          }
        }
      }
    }

    stage('Provision Worker Nodes (Parallel)') {
      when { expression { params.ACTION in ['bootstrap', 'reset'] } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def workers     = params.WORKER_IPS.tokenize(',').collect { it.trim() }
            def localWorker = "${env.WORKSPACE}/${SCRIPT_DIR}/02-linux-worker-setup.sh"
            def firewallValue = params.ENABLE_FIREWALL.toString()
            def branches    = [:]

            workers.each { workerIp ->
              def ip = workerIp
              branches["worker: ${ip}"] = {
                def remote = [name: ip, host: ip, user: params.SSH_USER,
                              password: env.SSH_PASS, allowAnyHosts: true]
                sshPut remote: remote, from: localWorker, into: '/tmp/02-linux-worker-setup.sh'
                sshPut remote: remote, from: env.JOIN_CMD_FILE, into: '/tmp/k8s-join-command.sh'

                def tStart = System.currentTimeMillis()
                sshCommand remote: remote, command: """
                  sed -i 's/\\r//' /tmp/02-linux-worker-setup.sh && \
                  chmod +x /tmp/02-linux-worker-setup.sh /tmp/k8s-join-command.sh && \
                  export K8S_VERSION='${params.K8S_VERSION}' \
                         RUNTIME='${params.RUNTIME}' \
                         CNI_PLUGIN='${params.CNI_PLUGIN}' \
                         JOIN_COMMAND_FILE='/tmp/k8s-join-command.sh' \
                         NODE_IP='${ip}' \
                         SETUP_USER='${params.SSH_USER}' \
                         ENABLE_FIREWALL='${firewallValue}' \
                         DEBIAN_FRONTEND=noninteractive && \
                  set +e
                  sudo -E bash /tmp/02-linux-worker-setup.sh
                  rc=$?
                  if [ "\$rc" -eq 141 ]; then
                    echo "Worker bootstrap returned 141 (SIGPIPE); retrying once..."
                    sleep 2
                    sudo -E bash /tmp/02-linux-worker-setup.sh
                    rc=$?
                  fi
                  exit "\$rc" 
                """.stripIndent().trim()

                recordTiming(timings, "worker-${ip}", tStart, System.currentTimeMillis())
                echo "Worker ${ip} provisioning complete."
              }
            }
            parallel branches
          }
        }
      }
    }

    // ═════════════════════════════════════════════════════════════════════════
    //  VERIFY CLUSTER
    // ═════════════════════════════════════════════════════════════════════════

    stage('Verify Cluster') {
      when { expression { params.ACTION in ['bootstrap', 'reset'] } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def masterRemote = [name: params.MASTER_IP, host: params.MASTER_IP,
                                user: params.SSH_USER, password: env.SSH_PASS, allowAnyHosts: true]
            def localValidate = "${env.WORKSPACE}/${SCRIPT_DIR}/07-validate.sh"

            if (!fileExists(localValidate)) {
              error("Validation script not found: ${localValidate}")
            }

            sshPut remote: masterRemote, from: localValidate, into: '/tmp/07-validate.sh'
            sshCommand remote: masterRemote, command: """
              sed -i 's/\\r//' /tmp/07-validate.sh && \\
              chmod +x /tmp/07-validate.sh && \\
              sudo -E bash /tmp/07-validate.sh
            """.stripIndent().trim()
          }
        }
      }
    }

    // ═════════════════════════════════════════════════════════════════════════
    //  DESTROY  (all nodes in parallel)
    // ═════════════════════════════════════════════════════════════════════════

    stage('Destroy Cluster') {
      when { expression { params.ACTION == 'destroy' } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def allIPs = ([params.MASTER_IP] + params.WORKER_IPS.tokenize(',').collect { it.trim() }).unique()
            def localDestroy = "${env.WORKSPACE}/${SCRIPT_DIR}/03-linux-destroy.sh"
            def branches = [:]

            allIPs.each { ip ->
              def host = ip
              branches["destroy: ${host}"] = {
                def remote = [name: host, host: host, user: params.SSH_USER,
                              password: env.SSH_PASS, allowAnyHosts: true]
                sshPut remote: remote, from: localDestroy, into: '/tmp/03-linux-destroy.sh'

                def tStart = System.currentTimeMillis()
                sshCommand remote: remote, command: """
                  sed -i 's/\\r//' /tmp/03-linux-destroy.sh && \\
                  chmod +x /tmp/03-linux-destroy.sh && \\
                  export RUNTIME='${params.RUNTIME}' \\
                         CNI_PLUGIN='${params.CNI_PLUGIN}' \\
                         DEBIAN_FRONTEND=noninteractive && \\
                  sudo -E bash /tmp/03-linux-destroy.sh
                """.stripIndent().trim()

                recordTiming(timings, "destroy-${host}", tStart, System.currentTimeMillis())
                echo "Destroy complete on ${host}"
              }
            }
            parallel branches
          }
        }
      }
    }

    // ═════════════════════════════════════════════════════════════════════════
    //  UPGRADE  (version-gap-aware: upgrades minor-by-minor)
    // ═════════════════════════════════════════════════════════════════════════
    stage('Detect Current K8s Version') {
      when { expression { params.ACTION == 'upgrade' } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            if (params.K8S_CURRENT_VERSION?.trim()) {
              env.CURRENT_K8S_VERSION = params.K8S_CURRENT_VERSION.trim()
              echo "Using provided current version: ${env.CURRENT_K8S_VERSION}"
            } else {
              def masterRemote = [name: params.MASTER_IP, host: params.MASTER_IP,
                                  user: params.SSH_USER, password: env.SSH_PASS, allowAnyHosts: true]
              def raw = sshCommand remote: masterRemote,
                command: '''
                  set -o pipefail
                  v=\$(sudo kubectl version -o json 2>/dev/null |
                      grep -oP '"gitVersion"\\s*:\\s*"v\\K\\d+\\.\\d+\\.\\d+"' |
                      head -1) || true
                  if [ -n "\$v" ]; then
                    printf '%s\\n' "\$v"
                  else
                    kubelet --version 2>/dev/null |
                      grep -oP '\\d+\\.\\d+\\.\\d+' |
                      head -1
                  fi
                '''.stripIndent().trim()
              env.CURRENT_K8S_VERSION = raw.trim()
              echo "Auto-detected current version: ${env.CURRENT_K8S_VERSION}"
            }
            if (!(env.CURRENT_K8S_VERSION ==~ /\d+\.\d+\.\d+/)) {
              error("Could not determine current K8s version. Set K8S_CURRENT_VERSION parameter.")
            }
          }
        }
      }
    }

    stage('Compute Upgrade Path') {
      when { expression { params.ACTION == 'upgrade' } }
      steps {
        script {
          def from = env.CURRENT_K8S_VERSION
          def to   = params.K8S_VERSION

          def fromMinor = from.split('\\.')[1].toInteger()
          def toMinor   = to.split('\\.')[1].toInteger()

          if (fromMinor == toMinor) {
            env.UPGRADE_PATH = to
            echo "Patch upgrade: ${from} → ${to}"
          } else if (toMinor < fromMinor) {
            error("Downgrade not supported: current=${from} target=${to}")
          } else {
            def steps = buildVersionPath(from, to)
            def hops = steps.collect { minor ->
              minor == "${to.split('\\.')[0]}.${toMinor}" ? to : "${minor}.0"
            }
            env.UPGRADE_PATH = hops.join(',')
            echo "Multi-step upgrade path: ${from} → ${hops.join(' → ')}"
          }

          if (!env.UPGRADE_PATH?.trim()) {
            error("Upgrade path is empty; refusing to run upgrade")
          }
        }
      }
    }

    stage('Upgrade Cluster') {
      when { expression { params.ACTION == 'upgrade' } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def masterRemote = [name: params.MASTER_IP, host: params.MASTER_IP,
                                user: params.SSH_USER, password: env.SSH_PASS, allowAnyHosts: true]
            def workers      = params.WORKER_IPS.tokenize(',').collect { it.trim() }
            def localUpgrade = "${env.WORKSPACE}/${SCRIPT_DIR}/04-linux-upgrade.sh"
            def hopVersions  = env.UPGRADE_PATH.split(',').collect { it.trim() }

            hopVersions.each { hopVer ->
              echo "━━━ Upgrading to ${hopVer} ━━━"

              sshPut remote: masterRemote, from: localUpgrade, into: '/tmp/04-linux-upgrade.sh'
              def tStart = System.currentTimeMillis()
              sshCommand remote: masterRemote, command: """
                sed -i 's/\\r//' /tmp/04-linux-upgrade.sh && \\
                chmod +x /tmp/04-linux-upgrade.sh && \\
                export K8S_VERSION='${hopVer}' \\
                       NODE_ROLE='master' \\
                       RUNTIME='${params.RUNTIME}' \\
                       MASTER_IP='${params.MASTER_IP}' \\
                       DEBIAN_FRONTEND=noninteractive && \\
                sudo -E bash /tmp/04-linux-upgrade.sh
              """.stripIndent().trim()
              recordTiming(timings, "upgrade-master-${hopVer}", tStart, System.currentTimeMillis())

              def wBranches = [:]
              workers.each { workerIp ->
                def ip = workerIp
                wBranches["upgrade-worker-${ip}-${hopVer}"] = {
                  def workerRemote = [name: ip, host: ip, user: params.SSH_USER,
                                      password: env.SSH_PASS, allowAnyHosts: true]
                  sshPut remote: workerRemote, from: localUpgrade, into: '/tmp/04-linux-upgrade.sh'
                  def wStart = System.currentTimeMillis()
                  sshCommand remote: workerRemote, command: """
                    sed -i 's/\\r//' /tmp/04-linux-upgrade.sh && \\
                    chmod +x /tmp/04-linux-upgrade.sh && \\
                    export K8S_VERSION='${hopVer}' \\
                           NODE_ROLE='worker' \\
                           RUNTIME='${params.RUNTIME}' \\
                           MASTER_IP='${params.MASTER_IP}' \\
                           DEBIAN_FRONTEND=noninteractive && \\
                    sudo -E bash /tmp/04-linux-upgrade.sh
                  """.stripIndent().trim()
                  recordTiming(timings, "upgrade-worker-${ip}-${hopVer}", wStart, System.currentTimeMillis())
                }
              }
              parallel wBranches

              echo "All nodes upgraded to ${hopVer}"
            }
          }
        }
      }
    }

  } // end stages

  post {
    always {
      script {
        sh("rm -f -- '${env.WORKSPACE}/.k8s-join-command.sh' 2>/dev/null || true")
        def pipeEnd   = System.currentTimeMillis()
        def totalMs   = (pipeStart > 0L) ? (pipeEnd - pipeStart) : 0L

        def fmtDur = { long ms ->
          if (ms <= 0) return 'N/A'
          def s = (ms / 1000) as int
          def m = s.intdiv(60); s = s % 60
          "${m}m ${s}s"
        }

        def rows = timings.collect { label, t ->
          def dur = (t.start > 0 && t.end > 0) ? fmtDur(t.end - t.start) : 'N/A'
          "  ${label.padRight(38)} ${dur}"
        }.sort()

        echo """
╔══════════════════════════════════════════════════════╗
║  ${params.ACTION.toUpperCase()} TIMING SUMMARY
╠══════════════════════════════════════════════════════╣
${rows.join('\n')}
╠══════════════════════════════════════════════════════╣
║  TOTAL : ${fmtDur(totalMs).padRight(43)}║
╚══════════════════════════════════════════════════════╝
"""

        def icon = currentBuild.currentResult == 'SUCCESS' ? '[OK]' :
                   currentBuild.currentResult == 'UNSTABLE' ? '[WARN]' : '[FAIL]'
        echo """
+==============================================================+
|  ${icon}  K8s Cluster ${params.ACTION.toUpperCase()}  —  ${currentBuild.currentResult}
+==============================================================+
|  Master  : ${params.MASTER_IP}
|  Workers : ${params.WORKER_IPS}
|  Runtime : ${params.RUNTIME}  |  CNI: ${params.CNI_PLUGIN}
|  Version : ${params.K8S_VERSION}
|  Firewall: ${params.ENABLE_FIREWALL}
+==============================================================+
"""
      }
    }
  }
}
