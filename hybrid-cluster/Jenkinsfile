// =============================================================================
//  Jenkinsfile  —  Kubernetes Cluster Bootstrap / Destroy  (dispatcher)
//  Calls Jenkinsfile.provision or Jenkinsfile.destroy based on ACTION param.
//
//  Fix applied: removed ansiColor('xterm') from options{} — that step requires
//  the AnsiColor plugin AND must live inside wrap{}, not options{}.
//  Separate provision / destroy pipeline files are now the recommended pattern.
// =============================================================================

def isWindowsAgent() { !isUnix() }

def timings   = [:]
def pipeStart = 0L

pipeline {

  agent any

  parameters {
    choice(
      name: 'ACTION',
      choices: ['bootstrap', 'destroy'],
      description: 'bootstrap — provision full cluster | destroy — tear down all nodes'
    )
    string(
      name: 'MASTER_IP',
      defaultValue: '192.168.56.11',
      description: 'Control-plane node IP'
    )
    string(
      name: 'WORKER_IPS',
      defaultValue: '192.168.56.12,192.168.56.13',
      description: 'Comma-separated worker IPs'
    )
    string(
      name: 'SSH_USER',
      defaultValue: 'k8sadmin',
      description: 'SSH user on all nodes (must have NOPASSWD sudo)'
    )
    credentials(
      name: 'SSH_CREDS_ID',
      credentialType: 'com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl',
      defaultValue: 'K8S_SSH_CREDS',
      description: 'Jenkins credential ID for SSH username+password'
    )
    choice(
      name: 'RUNTIME',
      choices: ['containerd', 'crio'],
      description: 'Container runtime: containerd | crio'
    )
    choice(
      name: 'CNI_PLUGIN',
      choices: ['calico', 'flannel', 'weave'],
      description: 'CNI plugin: calico | flannel | weave'
    )
    string(
      name: 'K8S_VERSION',
      defaultValue: '1.32.3',
      description: 'Kubernetes version (e.g. 1.32.3)'
    )
    string(
      name: 'POD_CIDR',
      defaultValue: '10.244.0.0/16',
      description: 'Pod network CIDR (10.244.0.0/16 for Flannel/Weave; Calico adapts automatically)'
    )
  }

  // ── ansiColor removed from options — it is not a valid option type.
  //    Use wrap([$class: 'AnsiColorBuildWrapper', colorMapName: 'xterm']) { }
  //    around specific steps if ANSI colour output is needed.
  options {
    timestamps()
    timeout(time: 60, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  environment {
    SCRIPT_DIR = 'hybrid-cluster'
  }

  stages {

    // ──────────────────────────────────────────────────────────────────────────
    stage('Validate Inputs') {
      steps {
        script {
          pipeStart = System.currentTimeMillis()
          def agentOS = isWindowsAgent() ? 'Windows' : 'Linux/Mac'
          def workers = params.WORKER_IPS.tokenize(',').collect { it.trim() }

          echo "Jenkins agent OS : ${agentOS}"
          echo "ACTION           : ${params.ACTION}"
          echo "Master IP        : ${params.MASTER_IP}"
          echo "Worker IPs       : ${workers.join(', ')}"
          echo "Runtime          : ${params.RUNTIME}"
          echo "CNI              : ${params.CNI_PLUGIN}"
          echo "K8s version      : ${params.K8S_VERSION}"
          echo "Pod CIDR         : ${params.POD_CIDR}"

          if (!params.MASTER_IP?.trim())  error("MASTER_IP is required")
          if (!params.WORKER_IPS?.trim()) error("WORKER_IPS is required")
        }
      }
    }

    // ──────────────────────────────────────────────────────────────────────────
    stage('Verify SSH Connectivity') {
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def allIPs = ([params.MASTER_IP] + params.WORKER_IPS.tokenize(',').collect { it.trim() }).unique()
            def branches = [:]
            allIPs.each { ip ->
              def host = ip
              branches["ssh-check: ${host}"] = {
                def remote = [
                  name        : host,
                  host        : host,
                  user        : params.SSH_USER,
                  password    : env.SSH_PASS,
                  allowAnyHosts: true
                ]
                sshCommand remote: remote,
                  command: "echo \"SSH OK from \$(hostname) as \$(whoami)\""
                sshCommand remote: remote,
                  command: "sudo -n whoami | grep -q root && echo 'SUDO OK' || (echo 'SUDO FAILED' && exit 1)"
              }
            }
            parallel branches
            echo "All ${allIPs.size()} node(s) reachable. SSH + sudo verified."
          }
        }
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  BOOTSTRAP PATH
    // ══════════════════════════════════════════════════════════════════════════

    stage('Provision Master Node') {
      when { expression { params.ACTION == 'bootstrap' } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def masterRemote = [
              name        : params.MASTER_IP,
              host        : params.MASTER_IP,
              user        : params.SSH_USER,
              password    : env.SSH_PASS,
              allowAnyHosts: true
            ]

            echo "============================================================"
            echo " Provisioning MASTER: ${params.MASTER_IP}"
            echo " Runtime: ${params.RUNTIME}  |  CNI: ${params.CNI_PLUGIN}"
            echo "============================================================"

            def localScript = isWindowsAgent()
              ? "${env.WORKSPACE}\\${SCRIPT_DIR}\\01-linux-master-setup.sh"
              : "${env.WORKSPACE}/${SCRIPT_DIR}/01-linux-master-setup.sh"

            sshPut remote: masterRemote,
              from: localScript,
              into: '/tmp/01-linux-master-setup.sh'

            timings['master'] = [start: System.currentTimeMillis(), end: 0L]

            sshCommand remote: masterRemote, command: """
              sed -i 's/\\r//' /tmp/01-linux-master-setup.sh && \\
              chmod +x /tmp/01-linux-master-setup.sh && \\
              export MASTER_IP='${params.MASTER_IP}' \\
                     K8S_VERSION='${params.K8S_VERSION}' \\
                     RUNTIME='${params.RUNTIME}' \\
                     CNI_PLUGIN='${params.CNI_PLUGIN}' \\
                     POD_CIDR='${params.POD_CIDR}' \\
                     SETUP_USER='${params.SSH_USER}' \\
                     DEBIAN_FRONTEND=noninteractive && \\
              sudo -E bash /tmp/01-linux-master-setup.sh
            """.stripIndent().trim()

            timings['master'].end = System.currentTimeMillis()
            echo "Master provisioning complete."
          }
        }
      }
    }

    stage('Extract Join Command') {
      when { expression { params.ACTION == 'bootstrap' } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def masterRemote = [
              name        : params.MASTER_IP,
              host        : params.MASTER_IP,
              user        : params.SSH_USER,
              password    : env.SSH_PASS,
              allowAnyHosts: true
            ]
            def joinCmd = sshCommand remote: masterRemote,
              command: "sudo cat /tmp/k8s-join-command.sh"

            if (!joinCmd?.trim()) error("Failed to retrieve join command from master")
            env.JOIN_COMMAND = joinCmd.trim()
            echo "Join command extracted."
          }
        }
      }
    }

    stage('Provision Worker Nodes (Parallel)') {
      when { expression { params.ACTION == 'bootstrap' } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def workers  = params.WORKER_IPS.tokenize(',').collect { it.trim() }
            def branches = [:]
            workers.each { workerIp ->
              def ip = workerIp
              branches["worker: ${ip}"] = {
                def workerRemote = [
                  name        : ip,
                  host        : ip,
                  user        : params.SSH_USER,
                  password    : env.SSH_PASS,
                  allowAnyHosts: true
                ]
                def localScript = isWindowsAgent()
                  ? "${env.WORKSPACE}\\${SCRIPT_DIR}\\02-linux-worker-setup.sh"
                  : "${env.WORKSPACE}/${SCRIPT_DIR}/02-linux-worker-setup.sh"

                sshPut remote: workerRemote,
                  from: localScript,
                  into: '/tmp/02-linux-worker-setup.sh'

                def tStart = System.currentTimeMillis()
                sshCommand remote: workerRemote, command: """
                  sed -i 's/\\r//' /tmp/02-linux-worker-setup.sh && \\
                  chmod +x /tmp/02-linux-worker-setup.sh && \\
                  export K8S_VERSION='${params.K8S_VERSION}' \\
                         RUNTIME='${params.RUNTIME}' \\
                         JOIN_COMMAND='${env.JOIN_COMMAND}' \\
                         NODE_IP='${ip}' \\
                         SETUP_USER='${params.SSH_USER}' \\
                         DEBIAN_FRONTEND=noninteractive && \\
                  sudo -E bash /tmp/02-linux-worker-setup.sh
                """.stripIndent().trim()

                def tEnd = System.currentTimeMillis()
                synchronized(timings) {
                  timings["worker-${ip}"] = [start: tStart, end: tEnd]
                }
                echo "Worker ${ip} provisioning complete."
              }
            }
            parallel branches
          }
        }
      }
    }

    stage('Verify Cluster') {
      when { expression { params.ACTION == 'bootstrap' } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def masterRemote = [
              name        : params.MASTER_IP,
              host        : params.MASTER_IP,
              user        : params.SSH_USER,
              password    : env.SSH_PASS,
              allowAnyHosts: true
            ]
            echo "Waiting up to 3 minutes for all nodes to be Ready..."
            def allReady = false
            def workers  = params.WORKER_IPS.tokenize(',').collect { it.trim() }
            def expected = workers.size() + 1

            for (int attempt = 0; attempt < 36; attempt++) {
              def output = sshCommand remote: masterRemote,
                command: "sudo kubectl get nodes --no-headers 2>/dev/null || true"
              def readyCount = output.split('\n').findAll { it.contains('Ready') && !it.contains('NotReady') }.size()
              echo "Attempt ${attempt+1}/36 — ${readyCount}/${expected} nodes Ready"
              if (readyCount >= expected) { allReady = true; break }
              sleep 5
            }

            def nodesOut = sshCommand remote: masterRemote,
              command: "sudo kubectl get nodes -o wide 2>/dev/null || true"
            echo "── kubectl get nodes ──────────────────────────────────"
            echo nodesOut

            def podsOut = sshCommand remote: masterRemote,
              command: "sudo kubectl get pods -n kube-system 2>/dev/null || true"
            echo "── kube-system pods ───────────────────────────────────"
            echo podsOut

            if (!allReady) unstable("Not all nodes reached Ready state within timeout")
          }
        }
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  DESTROY PATH
    // ══════════════════════════════════════════════════════════════════════════

    stage('Destroy Cluster') {
      when { expression { params.ACTION == 'destroy' } }
      steps {
        withCredentials([usernamePassword(
            credentialsId: params.SSH_CREDS_ID,
            usernameVariable: 'SSH_USER_VAR',
            passwordVariable: 'SSH_PASS'
        )]) {
          script {
            def allIPs   = ([params.MASTER_IP] + params.WORKER_IPS.tokenize(',').collect { it.trim() }).unique()
            def branches = [:]

            def localDestroy = isWindowsAgent()
              ? "${env.WORKSPACE}\\${SCRIPT_DIR}\\03-linux-destroy.sh"
              : "${env.WORKSPACE}/${SCRIPT_DIR}/03-linux-destroy.sh"

            allIPs.each { ip ->
              def host = ip
              branches["destroy: ${host}"] = {
                def remote = [
                  name        : host,
                  host        : host,
                  user        : params.SSH_USER,
                  password    : env.SSH_PASS,
                  allowAnyHosts: true
                ]
                def start = System.currentTimeMillis()

                sshPut remote: remote,
                  from: localDestroy,
                  into: '/tmp/03-linux-destroy.sh'

                sshCommand remote: remote,
                  command: """
                    sed -i 's/\\r//' /tmp/03-linux-destroy.sh && \\
                    chmod +x /tmp/03-linux-destroy.sh && \\
                    export RUNTIME='${params.RUNTIME}' \\
                           CNI_PLUGIN='${params.CNI_PLUGIN}' \\
                           DEBIAN_FRONTEND=noninteractive && \\
                    sudo -E bash /tmp/03-linux-destroy.sh
                  """.stripIndent().trim()

                synchronized(timings) {
                  timings["destroy-${host}"] = [start: start, end: System.currentTimeMillis()]
                }
                echo "Destroy complete on ${host}"
              }
            }
            parallel branches
          }
        }
      }
    }

  } // end stages

  post {
    always {
      script {
        def pipeEnd   = System.currentTimeMillis()
        def totalSecs = (pipeEnd - pipeStart) / 1000

        def fmtDur = { long ms ->
          if (ms <= 0) return 'N/A'
          def s = (ms / 1000) as int
          def m = s.intdiv(60)
          s = s % 60
          "${m}m ${s}s"
        }

        def header  = String.format("%-30s  %10s  %10s  %10s",
                                    "Node", "Start (rel)", "End (rel)", "Duration")
        def divider = '-' * header.length()

        def rows = timings.collect { label, t ->
          def relStart = t.start > 0 ? fmtDur(t.start - pipeStart) : 'N/A'
          def relEnd   = t.end   > 0 ? fmtDur(t.end   - pipeStart) : 'N/A'
          def dur      = (t.start > 0 && t.end > 0) ? fmtDur(t.end - t.start) : 'N/A'
          [label: label, relStart: relStart, relEnd: relEnd, dur: dur]
        }.sort { a, b -> a.label <=> b.label }

        def tableLines = [
          '',
          '╔══════════════════════════════════════════════════════════════════════════╗',
          "║   ${params.ACTION.toUpperCase()} TIMING SUMMARY${' ' * (54 - params.ACTION.length())}║",
          '╠══════════════════════════════════════════════════════════════════════════╣',
          "║  ${header}  ║",
          "║  ${divider}  ║",
        ]
        rows.each { r ->
          def line = String.format("%-30s  %10s  %10s  %10s",
                                   r.label, r.relStart, r.relEnd, r.dur)
          tableLines << "║  ${line}  ║"
        }
        tableLines += [
          '╠══════════════════════════════════════════════════════════════════════════╣',
          "║  ${'TOTAL PIPELINE TIME:'.padRight(42)} ${fmtDur((long)(totalSecs * 1000))}  ║",
          '╚══════════════════════════════════════════════════════════════════════════╝',
          '',
        ]
        echo tableLines.join('\n')

        def status = currentBuild.currentResult
        def icon   = status == 'SUCCESS' ? '[OK]' : (status == 'UNSTABLE' ? '[WARN]' : '[FAIL]')

        echo """
+==================================================================+
|  ${icon}  Kubernetes Cluster ${params.ACTION.toUpperCase().padRight(10)} -- ${status.padRight(8)}              |
+==================================================================+
|  Master    : ${params.MASTER_IP.padRight(48)}|
|  Workers   : ${params.WORKER_IPS.padRight(48)}|
|  Runtime   : ${params.RUNTIME.padRight(48)}|
|  CNI       : ${params.CNI_PLUGIN.padRight(48)}|
|  K8s ver   : ${params.K8S_VERSION.padRight(48)}|
+==================================================================+
"""
      }
    }
  }
}
