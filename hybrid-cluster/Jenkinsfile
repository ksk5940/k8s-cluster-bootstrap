// =============================================================================
// Jenkinsfile — Kubernetes Cluster Bootstrap Pipeline
// Compatible with: Jenkins on Windows OR Linux (auto-detected at runtime)
// Target nodes  : Ubuntu / Rocky Linux
//
// Uses: SSH Pipeline Steps Plugin → https://plugins.jenkins.io/ssh-steps/
//
// Scripts live in the SAME repo as this Jenkinsfile:
//   hybrid-cluster/01-linux-master-setup.sh
//   hybrid-cluster/02-linux-worker-setup.sh
//
// Jenkins Credential Setup (once):
//   Manage Jenkins → Credentials → global → Add Credentials
//     Kind     : Username with password
//     Username : root
//     Password : <your root password>
//     ID       : K8S_SSH_CREDS
// =============================================================================

pipeline {

    agent any

    parameters {
        string(
            name: 'MASTER_IP',
            defaultValue: '',
            description: 'IP address of the Kubernetes MASTER node.\nExample: 192.168.56.11'
        )
        string(
            name: 'WORKER_IPS',
            defaultValue: '',
            description: 'Comma-separated WORKER node IPs.\nExample: 192.168.56.12,192.168.56.13\nAdd as many as needed — all provisioned in parallel.'
        )
        string(
            name: 'SSH_CREDENTIALS_ID',
            defaultValue: 'K8S_SSH_CREDS',
            description: 'Jenkins Credentials ID (Username + Password) for all nodes.'
        )
    }

    environment {
        REMOTE_MASTER_SCRIPT = '/tmp/01-linux-master-setup.sh'
        REMOTE_WORKER_SCRIPT = '/tmp/02-linux-worker-setup.sh'
    }

    stages {

        // =====================================================================
        // Stage 0 — Detect Jenkins OS + Validate Inputs
        // =====================================================================
        stage('Validate Inputs') {
            steps {
                script {
                    // ---- Detect Jenkins agent OS ----
                    // isUnix() returns true on Linux/Mac, false on Windows
                    env.IS_UNIX = isUnix() ? 'true' : 'false'
                    echo "Jenkins agent OS: ${isUnix() ? 'Linux/Mac' : 'Windows'}"

                    // ---- Set script paths using correct separator ----
                    if (isUnix()) {
                        env.LOCAL_MASTER_SCRIPT = 'hybrid-cluster/01-linux-master-setup.sh'
                        env.LOCAL_WORKER_SCRIPT = 'hybrid-cluster/02-linux-worker-setup.sh'
                    } else {
                        env.LOCAL_MASTER_SCRIPT = 'hybrid-cluster\\01-linux-master-setup.sh'
                        env.LOCAL_WORKER_SCRIPT = 'hybrid-cluster\\02-linux-worker-setup.sh'
                    }

                    // ---- Validate params ----
                    if (!params.MASTER_IP?.trim()) {
                        error('MASTER_IP cannot be empty.')
                    }
                    if (!params.WORKER_IPS?.trim()) {
                        error('WORKER_IPS cannot be empty.')
                    }

                    def workers = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                    if (workers.isEmpty()) {
                        error('No valid worker IPs found after parsing.')
                    }

                    echo "Master IP    : ${params.MASTER_IP.trim()}"
                    echo "Worker IPs   : ${workers.join(', ')}"
                    echo "Worker count : ${workers.size()}"
                    echo "Credentials  : ${params.SSH_CREDENTIALS_ID}"
                }
            }
        }

        // =====================================================================
        // Stage 1 — Verify SSH Connectivity (all nodes in parallel)
        // =====================================================================
        stage('Verify SSH Connectivity') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: params.SSH_CREDENTIALS_ID,
                    usernameVariable: 'SSH_USER',
                    passwordVariable: 'SSH_PASS'
                )]) {
                    script {
                        def workers  = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                        def allNodes = [params.MASTER_IP.trim()] + workers
                        def checks   = [:]

                        allNodes.each { ip ->
                            checks["ssh-check: ${ip}"] = {
                                def remote = buildRemote(ip, env.SSH_USER, env.SSH_PASS)
                                sshCommand remote: remote,
                                           command: 'echo "SSH OK from $(hostname) [$(hostname -I | tr -d \'\\n\')]"'
                            }
                        }

                        parallel checks
                        echo "All ${allNodes.size()} node(s) reachable via SSH."
                    }
                }
            }
        }

        // =====================================================================
        // Stage 2 — Provision Master Node
        //
        // sshPut copies script from Jenkins workspace (Windows or Linux path)
        // sed strips CRLF in case Jenkins ran on Windows (no-op on Linux)
        // bash runs the cleaned script
        // =====================================================================
        stage('Provision Master Node') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: params.SSH_CREDENTIALS_ID,
                    usernameVariable: 'SSH_USER',
                    passwordVariable: 'SSH_PASS'
                )]) {
                    script {
                        def masterIp = params.MASTER_IP.trim()
                        def remote   = buildRemote(masterIp, env.SSH_USER, env.SSH_PASS)

                        echo "============================================================"
                        echo " Jenkins OS  : ${env.IS_UNIX == 'true' ? 'Linux/Mac' : 'Windows'}"
                        echo " Provisioning MASTER: ${masterIp}"
                        echo "============================================================"

                        // sshPut works with both Windows and Linux local paths
                        sshPut remote: remote,
                               from: env.LOCAL_MASTER_SCRIPT,
                               into: env.REMOTE_MASTER_SCRIPT

                        // sed 's/\r//' = strip Windows CRLF (safe no-op if already LF)
                        // Works on Ubuntu and Rocky Linux
                        sshCommand remote: remote,
                                   command: "sed -i 's/\\r//' ${env.REMOTE_MASTER_SCRIPT} && chmod +x ${env.REMOTE_MASTER_SCRIPT} && bash ${env.REMOTE_MASTER_SCRIPT}"

                        echo "Master provisioning COMPLETE: ${masterIp}"
                    }
                }
            }
        }

        // =====================================================================
        // Stage 3 — Extract kubeadm join command from master
        // =====================================================================
        stage('Extract Join Command') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: params.SSH_CREDENTIALS_ID,
                    usernameVariable: 'SSH_USER',
                    passwordVariable: 'SSH_PASS'
                )]) {
                    script {
                        def masterIp = params.MASTER_IP.trim()
                        def remote   = buildRemote(masterIp, env.SSH_USER, env.SSH_PASS)

                        echo "Fetching kubeadm join command from master ${masterIp} ..."

                        def rawOutput = sshCommand(
                            remote      : remote,
                            command     : 'kubeadm token create --print-join-command 2>/dev/null',
                            returnStdout: true
                        ).trim()

                        def joinLine = rawOutput.split('\n')
                                               .collect { it.trim() }
                                               .find { it.startsWith('kubeadm join') }

                        if (!joinLine) {
                            error("Could not find 'kubeadm join' line.\nRaw output:\n${rawOutput}")
                        }

                        env.JOIN_COMMAND = joinLine
                        echo "Join command captured."
                        echo "Preview: ${joinLine.take(72)}..."
                    }
                }
            }
        }

        // =====================================================================
        // Stage 4 — Provision Worker Nodes IN PARALLEL
        // =====================================================================
        stage('Provision Worker Nodes (Parallel)') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: params.SSH_CREDENTIALS_ID,
                    usernameVariable: 'SSH_USER',
                    passwordVariable: 'SSH_PASS'
                )]) {
                    script {
                        def workers    = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                        def joinCmd    = env.JOIN_COMMAND
                        def workerJobs = [:]

                        workers.eachWithIndex { ip, idx ->
                            def workerIp = ip
                            def num      = idx + 1

                            workerJobs["worker-${num} [${workerIp}]"] = {
                                def remote = buildRemote(workerIp, env.SSH_USER, env.SSH_PASS)

                                echo "============================================================"
                                echo " Provisioning WORKER ${num}: ${workerIp}"
                                echo "============================================================"

                                // Copy script (works with Windows or Linux local path)
                                sshPut remote: remote,
                                       from: env.LOCAL_WORKER_SCRIPT,
                                       into: env.REMOTE_WORKER_SCRIPT

                                // 1. Strip CRLF (safe no-op if already LF)
                                // 2. Make executable
                                // 3. Inject join command (bypasses interactive read)
                                // 4. Execute
                                def escapedJoin = joinCmd.replace("'", "'\\''")
                                sshCommand remote: remote, command: """
                                    sed -i 's/\\r//' ${env.REMOTE_WORKER_SCRIPT} && \
                                    chmod +x ${env.REMOTE_WORKER_SCRIPT} && \
                                    sed -i "s|read -r JOIN_CMD|JOIN_CMD='${escapedJoin}'|g" ${env.REMOTE_WORKER_SCRIPT} && \
                                    bash ${env.REMOTE_WORKER_SCRIPT}
                                """

                                echo "Worker ${num} (${workerIp}) joined successfully."
                            }
                        }

                        workerJobs.failFast = false
                        parallel workerJobs
                    }
                }
            }
        }

        // =====================================================================
        // Stage 5 — Verify Cluster Health
        // =====================================================================
        stage('Verify Cluster') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: params.SSH_CREDENTIALS_ID,
                    usernameVariable: 'SSH_USER',
                    passwordVariable: 'SSH_PASS'
                )]) {
                    script {
                        def masterIp = params.MASTER_IP.trim()
                        def remote   = buildRemote(masterIp, env.SSH_USER, env.SSH_PASS)

                        echo "Waiting 20s for all nodes to register with the API server..."
                        sleep(20)

                        def nodeStatus = sshCommand(
                            remote      : remote,
                            command     : 'kubectl get nodes -o wide',
                            returnStdout: true
                        )

                        echo "============================================================"
                        echo " CLUSTER NODE STATUS"
                        echo "============================================================"
                        echo nodeStatus
                    }
                }
            }
        }
    }

    // -------------------------------------------------------------------------
    // POST
    // -------------------------------------------------------------------------
    post {
        success {
            script {
                def workers = params.WORKER_IPS.split(',').collect { it.trim() }.findAll { it }
                echo """
╔══════════════════════════════════════════════════════════════════╗
║        Kubernetes Cluster Bootstrap — SUCCESS                   ║
╠══════════════════════════════════════════════════════════════════╣
║  Master  : ${params.MASTER_IP.trim()}
║  Workers : ${params.WORKER_IPS.trim()}
║  Total   : 1 master + ${workers.size()} worker(s)
╠══════════════════════════════════════════════════════════════════╣
║  Verify:  kubectl get nodes -o wide                             ║
╚══════════════════════════════════════════════════════════════════╝"""
            }
        }
        failure {
            echo """
╔══════════════════════════════════════════════════════════════════╗
║        Kubernetes Cluster Bootstrap — FAILED                    ║
╠══════════════════════════════════════════════════════════════════╣
║  Troubleshooting checklist:                                     ║
║   1. SSH credentials correct in Jenkins credential store        ║
║   2. SSH Pipeline Steps plugin installed                        ║
║   3. All nodes reachable on port 22                             ║
║   4. Root password set on all nodes (passwd root)               ║
║   5. Nodes have 2GB+ RAM and 20GB+ disk                         ║
╚══════════════════════════════════════════════════════════════════╝"""
        }
        always {
            echo "Pipeline finished at: ${new Date()}"
        }
    }
}

// =============================================================================
// HELPER — Build SSH remote map for SSH Pipeline Steps plugin
// =============================================================================
def buildRemote(String ip, String user, String password) {
    return [
        name         : ip,
        host         : ip,
        port         : 22,
        user         : user,
        password     : password,
        allowAnyHosts: true,
        timeoutSec   : 3600
    ]
}
